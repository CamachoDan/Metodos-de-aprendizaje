        12, 16, 23, 27, 31, 35, 39, 43, 47, 13,
        24, 30, 38, 44, 48, 8, 17, 34, 52, 7
    ]
})

print("\n========== DATASET DE VIAJES ==========")
print(datos.to_string(index=False))
print("\nCantidad de registros:", len(datos))


# ============================================================
# 2. SELECCION DE VARIABLES
# ============================================================

# Variables de entrada que el modelo utiliza para aprender.
X = datos[
    ["tramos", "transferencias", "hora_pico"]
]

# Variable objetivo que el modelo debe predecir.
y = datos["tiempo_minutos"]


# ============================================================
# 3. DIVISION DE DATOS
# ============================================================

# Reservamos una parte de los datos para evaluar el modelo.
X_entrenamiento, X_prueba, y_entrenamiento, y_prueba = (
    train_test_split(
        X,
        y,
        test_size=0.25,
        random_state=42
    )
)


# ============================================================
# 4. ENTRENAMIENTO DEL MODELO DE REGRESION LINEAL
# ============================================================

# Creamos el modelo matematico.
modelo = LinearRegression()

# El modelo aprende la relacion entre las variables de entrada
# y el tiempo de viaje registrado en el dataset.
modelo.fit(X_entrenamiento, y_entrenamiento)

print("\n========== MODELO ENTRENADO ==========")
print("Algoritmo: Regresion lineal")

# Mostramos los coeficientes aprendidos por el modelo.
for variable, coeficiente in zip(X.columns, modelo.coef_):
    print(f"{variable}: {coeficiente:.2f}")

print("Intercepto:", round(modelo.intercept_, 2))


# ============================================================
# 5. EVALUACION DEL MODELO
# ============================================================

# Predecimos los tiempos de los registros reservados para prueba.
