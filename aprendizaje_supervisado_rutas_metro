# Calculamos el error absoluto medio.
mae = mean_absolute_error(
    y_prueba,
    predicciones_prueba
)

# Calculamos el coeficiente de determinacion.
r2 = r2_score(
    y_prueba,
    predicciones_prueba
)

print("\n========== EVALUACION DEL MODELO ==========")
print(f"Error absoluto medio (MAE): {mae:.2f} minutos")
print(f"Coeficiente de determinacion R2: {r2:.2f}")


# ============================================================
# 6. BASE DE CONOCIMIENTO DEL METRO
# ============================================================

# Estacion autorizada para cambiar entre las lineas A y B.
ESTACION_TRANSFERENCIA = "San Antonio"

# Estaciones de la linea A, de sur a norte.
LINEA_A = [
    "La Estrella",
    "Sabaneta",
    "Itagüí",
    "Envigado",
    "Ayurá",
    "Aguacatala",
    "Poblado",
    "Industriales",
    "Exposiciones",
